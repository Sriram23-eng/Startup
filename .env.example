# Copy to .env.local (local) or set in Vercel → Project → Settings → Environment Variables.

# Postgres connection string. When set, the app uses Postgres (Prisma).
# When UNSET, it falls back to the local JSON store in /data (no DB needed).
# Get a free one from Neon (https://neon.tech) or Supabase, or use Vercel Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Admin panel credentials (change these in production!).
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_TOKEN="any-long-random-string"

# Secret used to sign student login sessions. Set a long random string in prod.
AUTH_SECRET="another-long-random-string"

# Anthropic API key for the per-course AI tutor (Phase 2). Get one at
# https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY="sk-ant-..."
