# Copy to .env.local (local) or set in Vercel → Project → Settings → Environment Variables.

# Postgres connection string. When set, the app uses Postgres (Prisma).
# When UNSET, it falls back to the local JSON store in /data (no DB needed).
# Get a free one from Neon (https://neon.tech) or Supabase, or use Vercel Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# REQUIRED IN PRODUCTION. `npm run build` fails if any of the three below are
# missing or left as these placeholders. In development they fall back to
# public defaults so the app runs with no .env at all.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Admin panel sign-in (/admin). The username is not a secret — it is the other
# half of the credential pair. Defaults to "admin" when unset.
ADMIN_USER="admin"
ADMIN_PASSWORD="choose-a-strong-password"

# Value of the admin session cookie, checked by middleware.ts. Long + random.
ADMIN_TOKEN="any-long-random-string"

# HMAC key that signs student login sessions. Long + random.
# Changing it logs every student out.
AUTH_SECRET="another-long-random-string"

# Anthropic API key for the per-course AI tutor (Phase 2). Get one at
# https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY="sk-ant-..."

# Renders lesson scripts into real MP4 files (npm run render:videos).
# This is a video *compositor*, not a generative model — the text on screen is
# exactly the text we send, which is why code and pin numbers come out right.
# Get a key at json2video.com → Dashboard. Optional: without it, lessons play
# as narrated slides in the browser instead.
JSON2VIDEO_API_KEY=""
# Any voice the service supports. Defaults to Indian English.
JSON2VIDEO_VOICE="en-IN-NeerjaNeural"
JSON2VIDEO_RESOLUTION="full-hd"
