// Prisma schema for Elektron Nexus.
// Used in production (Postgres). Locally, if DATABASE_URL is unset, the app
// falls back to the JSON file store automatically — see lib/store.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Project {
  slug       String   @id
  title      String
  category   String
  size       String
  price      Int
  rating     Float    @default(4.8)
  reviews    Int      @default(0)
  image      String
  youtube    String?
  summary    String
  features   String[]
  components String[]
  readyMade  Boolean  @default(true)
  tags       String[]

  // Rich product fields (shown on the detail page / set in admin)
  badge           String   @default("") // Bestseller · New · Hot Deal · Limited
  originalPrice   Int? // for discount display
  currency        String   @default("INR")
  priceOptions    String   @default("") // lines "Label | price" — selectable buy options
  priceMultiSelect Boolean @default(false) // true = tick several add-ons (prices sum)
  status          String   @default("PUBLISHED") // PUBLISHED | DRAFT
  featured        Boolean  @default(false)
  order           Int      @default(0)
  about           String   @default("") // long description
  included        String[] @default([]) // what's included
  specs           String   @default("[]") // JSON: [{label,value}]
  requirements    String[] @default([])
  gallery         String[] @default([])
  license         String   @default("")
  version         String   @default("")
  sku             String   @default("")
  checkoutUrl     String   @default("")
  demoUrl         String   @default("")
  metaTitle       String   @default("")
  metaDescription String   @default("")
  ogImage         String   @default("")
  publishDate     String?

  createdAt  DateTime @default(now())
}

model Course {
  slug       String   @id
  title      String
  mode       String
  level      String
  category   String
  instructor String
  rating     Float    @default(4.8)
  learners   Int      @default(0)
  lessons    Int      @default(0)
  hours      Int      @default(0)
  price      Int
  oldPrice   Int?
  image      String
  blurb      String
  highlights String[]
  startDate  String?
  schedule   String?
  seatsLeft  Int?
  topics     String[] @default([]) // syllabus topics — also feeds the per-course AI tutor
  createdAt  DateTime @default(now())
}

// ----- Student accounts & access control -----

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("student") // student | admin
  accountType  String   @default("student") // student | college
  college      String? // institution name (college accounts)
  createdAt    DateTime @default(now())
}

// A reservation. status starts "pending"; admin sets it to "approved"
// (after payment) to unlock the course's recorded lessons + AI tutor.
model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  courseSlug  String
  courseTitle String
  status      String   @default("pending") // pending | approved | rejected
  createdAt   DateTime @default(now())

  @@index([userId])
}

// An enquiry from any of the public forms (contact / workshop / internship /
// custom-project). The four forms submit different field sets, so the common
// ones get real columns (for the admin table + search) and the complete
// submitted payload is kept verbatim in `details` — nothing is ever dropped.
model Lead {
  id      String @id @default(cuid())
  ref     String // customer-facing reference, e.g. "LEAD-7F3K2Q"
  type    String @default("general") // contact | workshop | internship | custom-project
  name    String @default("")
  email   String @default("")
  phone   String @default("")
  org     String @default("") // college / company
  subject String @default("") // topic, project title or domain
  message String @default("") // message / description / notes / why
  details String @default("{}") // full submitted payload as JSON

  status    String   @default("new") // new | contacted | closed
  createdAt DateTime @default(now())

  @@index([ref])
  @@index([status])
}

// ----- W3Schools-style structured course content -----

// A module groups topics, within a section band (Beginner/Intermediate/Advanced/Projects).
model CourseModule {
  id         String   @id @default(cuid())
  courseSlug String // ties to a Course (e.g. "iot-esp32-live")
  title      String
  band       String   @default("Beginner") // Beginner | Intermediate | Advanced | Projects
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  topics Topic[]

  @@index([courseSlug])
}

// A topic page — the W3Schools-style lesson with all its sections.
// kind: "topic" (theory lesson) | "practical" (hands-on) | "project".
model Topic {
  id       String       @id @default(cuid())
  moduleId String
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title    String
  kind     String       @default("topic")
  order    Int          @default(0)

  // The W3Schools-style content sections (authored via the admin editor):
  theory          String @default("") // 1. Theory
  diagramUrl      String @default("") // 2. Diagram (image URL)
  components      String @default("") // 3. Components required
  exampleCode     String @default("") // 4. Example code
  codeExplanation String @default("") // 4b. Line-by-line explanation
  outputImageUrl  String @default("") // 5. Output image (URL)
  videoUrl        String @default("") // 6. AI video (embed URL, made externally)
  quiz            String @default("") // 7. Quiz (MCQs / coding qs)
  exercise        String @default("") // 8. Exercise
  simulationUrl   String @default("") // 9. Simulation (Wokwi / Proteus link)
  miniProject     String @default("") // 10. Mini project
  downloads       String @default("") // 11. Downloads (links, one per line)

  createdAt DateTime @default(now())

  @@index([moduleId])
}
